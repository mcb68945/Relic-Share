<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loader: the only DLL the game loads. Picks RelicShare.V111.dll or RelicShare.V113.dll at startup. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RelicShare</AssemblyName>
    <RootNamespace>RelicShare</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameLibs>$(MSBuildThisFileDirectory)lib/v113</GameLibs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Loader.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameLibs)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameLibs)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameLibs)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
